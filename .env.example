# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# SQLite database file for storing prediction history (optional, Phase 7+)
#DATABASE_URL=sqlite:///./data/app.db

# API server bind settings (consumed by the backend, Phase 6)
#API_HOST=127.0.0.1
#API_PORT=8000

# Comma-separated origins allowed by CORS (Vite dev :5173, preview :4173)
#CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Where trained model artifacts live (Phase 5+)
#MODEL_REGISTRY_PATH=ml/registry

# Frontend API base URL (frontend/.env.local if ever needed; this default
# already works — the UI reads VITE_API_URL at build/dev time)
#VITE_API_URL=http://127.0.0.1:8000
